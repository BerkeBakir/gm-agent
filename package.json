{
  "name": "gm-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Autonomous AI game master that runs a daily puzzle game and manages its own on-chain treasury (Base Sepolia).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "dev:memory": "node scripts/dev-memory.mjs",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "balance": "tsx scripts/balance.ts",
    "simulate": "tsx scripts/simulate.ts",
    "demo:players": "tsx scripts/demo-players.ts",
    "mcp": "tsx mcp/server.ts",
    "mcp:setup": "tsx scripts/setup-mcp-player.ts",
    "treasury:setup": "tsx scripts/setup-treasury.ts",
    "treasury:demo": "tsx scripts/limit-demo.ts",
    "treasury:withdraw": "tsx scripts/withdraw-treasury.ts",
    "anna:build": "esbuild anna/src/main.ts --bundle --format=esm --target=es2022 --minify --outfile=anna/bundle/app.js",
    "anna:validate": "npm run anna:build && cd anna && npx -y @anna-ai/cli@latest validate --strict --bundle bundle",
    "anna:dev": "npm run anna:build && cd anna && npx -y @anna-ai/cli@latest dev --bundle bundle --no-llm",
    "anna:dev:llm": "npm run anna:build && cd anna && npx -y @anna-ai/cli@latest dev --bundle bundle"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@google/genai": "^2.24.0",
    "@metamask/smart-accounts-kit": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@neondatabase/serverless": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.48.0",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "viem": "^2.57.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
