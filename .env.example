# Copy to .env and fill in. Never commit .env.

# 1. Free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 2. (Optional) Which Gemini model to use
GEMINI_MODEL=gemini-flash-latest

# 3. Agent wallet — TESTNET ONLY. Leave empty locally and use the "Create wallet"
#    button (saved to .agent-wallet.json). On Vercel this MUST be set, since the
#    filesystem is read-only there.
WALLET_PRIVATE_KEY=

# Base Sepolia RPC (optional, defaults to the public endpoint)
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Spending guard (USDC, human-readable)
MAX_REWARD_PER_TX=2.00
MAX_DAILY_TREASURY_FRACTION=0.10
